@@ -0,0 +1,31 @@
+// PHONE (Blizz4A's Android build, VITE_PHONE=1): first-run defaults for a phone. A mid-range phone's CPU spends most of
+// each frame in script, and these rows are the heavy optional visuals and ambient simulation; gameplay rows are left as
+// they are. Each stays a normal pref: the player turns any of them back on in Features.
+export const PHONE_PREF_DEFAULTS = Object.freeze({
+  landViewDistance: 3,          // Daggerfall's own radius (the row's classic)
+  renderScale: 0.75,            // the world drawn at 3/4 and shown full size; the HUD stays sharp
+  enhancedEnvironments: false,  // the classic sky and weather instead of the living dome
+  enhancedWater: false,
+  waterQuality: 'simple',
+  wetWorld: 'off',
+  enhancedLighting: false,
+  steadyShadows: false,
+  moddedLighting: 'off',
+  grassDensity: 0,
+  cloudQuality: 'lo',
+  groundSharpness: 'off',
+  realWindows: 'off',
+  windowLight: 'off',
+  weaponGlow: false,
+  floraSway: false,
+  windWisps: false,
+  ambientLife: false,
+  firstPersonLighting: false,
+  weatherEvents: false,
+  realForests: false,
+  roadVerges: false,
+  killFxOthers: 'near',
+  armoryOthers: 'near',
+  mwNpcBodies: 'off',
+  mwSpellEffects: false,
+});
